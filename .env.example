# ==============================================================================
# ChronoDump Configuration & Secrets
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram User ID authorized to use this single-user bot
# Obtain this from @userinfobot or @raw_data_bot on Telegram
# Example: 987654321
AUTHORIZED_USER_ID=0

# Ollama local inference settings
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models: qwen2.5:3b, llama3.2:3b-instruct, qwen3:4b
OLLAMA_MODEL=qwen2.5:3b

# faster-whisper Speech-to-Text settings
# Options: base.en, tiny.en, small.en
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Database and Storage Settings
# SQLite database path
DATABASE_URL=sqlite:///data/chronodump.db
# APScheduler jobstore SQLite database path
SCHEDULER_DATABASE_URL=sqlite:///data/chronodump_scheduler.db

# Storage directory for temporary audio files and persistent data
DATA_DIR=./data

# Default timezone if not configured by user (e.g. UTC, Asia/Kolkata, America/New_York)
DEFAULT_TIMEZONE=UTC

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
